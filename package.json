{
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend exec tauri dev",
    "build": "npm --prefix frontend run build",
    "check:migration": "npm --prefix frontend run check:migration",
    "check:js": "node scripts/check-js-syntax.mjs",
    "check:invokes": "node scripts/check-tauri-invokes.mjs",
    "check:ipc-schema": "node scripts/check-ipc-schema.mjs",
    "check:tauri-surface": "node scripts/check-tauri-renderer-surface.mjs",
    "check:updater": "node scripts/check-updater-config.mjs",
    "check:workflows": "node scripts/check-github-workflows.mjs",
    "check:provider-surface": "node scripts/check-provider-surface.mjs",
    "check:windows-assets": "node scripts/check-windows-assets.mjs",
    "check:winui-packaging": "node scripts/check-winui-packaging.mjs",
    "check:winui-parity-gate": "node scripts/check-winui-parity-gate.mjs",
    "check:frontend": "npm --prefix frontend run check",
    "check": "npm run check:frontend && npm run check:js && npm run check:invokes && npm run check:ipc-schema && npm run check:tauri-surface && npm run check:updater && npm run check:workflows && npm run check:provider-surface && npm run check:windows-assets && npm run check:winui-packaging && npm run check:winui-parity-gate",
    "check:rust": "cargo fmt --all -- --check && cargo test --locked --all-features && cargo clippy --locked --all-targets --all-features -- -D warnings",
    "check:security": "node scripts/cargo-audit-release.mjs",
    "check:release": "npm run check && npm run check:rust && npm run check:security",
    "build:tauri:local": "cd src-tauri && cargo tauri build --ci --config tauri.local.conf.json",
    "build:winui": "dotnet build src-winui/SimpleFile.sln -c Debug",
    "build:winui:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-winui-release.ps1",
    "check:winui": "dotnet test src-winui/SimpleFile.Tests/SimpleFile.Tests.csproj -c Debug --nologo",
    "dev:winui": "cargo build -p simplefile-service && dotnet run --project src-winui/SimpleFile.App/SimpleFile.App.csproj -c Debug",
    "smoke:settings": "node scripts/smoke-settings-startup.mjs",
    "smoke:settings-ui": "npm --prefix frontend run smoke:settings-ui",
    "smoke:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-release-startup.ps1",
    "smoke:msi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-msi-artifact.ps1",
    "smoke:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-nsis-install.ps1",
    "smoke:winui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-winui-startup.ps1",
    "smoke:winui-msi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-winui-msi.ps1",
    "smoke:winui-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-winui-nsis.ps1",
    "release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "release:winui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-winui-release.ps1",
    "release:local": "npm run check:release && npm run build:tauri:local"
  }
}
