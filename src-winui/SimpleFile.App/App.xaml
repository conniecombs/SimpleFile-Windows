<Application
    x:Class="SimpleFile.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SfBgPrimary">#1E1E2E</Color>
            <Color x:Key="SfBgSecondary">#181825</Color>
            <Color x:Key="SfBgHover">#313244</Color>
            <Color x:Key="SfBgSelected">#45475A</Color>
            <Color x:Key="SfTextPrimary">#CDD6F4</Color>
            <Color x:Key="SfTextMuted">#6C7086</Color>
            <Color x:Key="SfAccent">#89B4FA</Color>
            <Color x:Key="SfBorder">#313244</Color>
            <SolidColorBrush x:Key="SfBgPrimaryBrush" Color="{StaticResource SfBgPrimary}" />
            <SolidColorBrush x:Key="SfBgSecondaryBrush" Color="{StaticResource SfBgSecondary}" />
            <SolidColorBrush x:Key="SfBgHoverBrush" Color="{StaticResource SfBgHover}" />
            <SolidColorBrush x:Key="SfBgSelectedBrush" Color="{StaticResource SfBgSelected}" />
            <SolidColorBrush x:Key="SfTextPrimaryBrush" Color="{StaticResource SfTextPrimary}" />
            <SolidColorBrush x:Key="SfTextMutedBrush" Color="{StaticResource SfTextMuted}" />
            <SolidColorBrush x:Key="SfAccentBrush" Color="{StaticResource SfAccent}" />
            <SolidColorBrush x:Key="SfBorderBrush" Color="{StaticResource SfBorder}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
