<Application
    x:Class="SimpleFile.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="SfIconFont">Segoe Fluent Icons</FontFamily>

            <!-- Aliases onto Windows Fluent colors so light/dark/accent/mica stay native. -->
            <SolidColorBrush x:Key="SfBgPrimaryBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" />
            <SolidColorBrush x:Key="SfBgSecondaryBrush" Color="{ThemeResource LayerFillColorDefault}" />
            <SolidColorBrush x:Key="SfBgTertiaryBrush" Color="{ThemeResource ControlFillColorDefault}" />
            <SolidColorBrush x:Key="SfBgHoverBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="SfBgPressedBrush" Color="{ThemeResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="SfBgSelectedBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="SfTextPrimaryBrush" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="SfTextMutedBrush" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="SfAccentBrush" Color="{ThemeResource AccentFillColorDefault}" />
            <SolidColorBrush x:Key="SfAccentSoftBrush" Color="{ThemeResource AccentFillColorDefault}" Opacity="0.2" />
            <SolidColorBrush x:Key="SfBorderBrush" Color="{ThemeResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="SfFolderBrush" Color="#E6B422" />
            <SolidColorBrush x:Key="SfFileBrush" Color="{ThemeResource AccentFillColorDefault}" />
            <SolidColorBrush x:Key="SfTransparentBrush" Color="Transparent" />

            <Style x:Key="SfCompactAppBarStyle" TargetType="AppBarButton">
                <Setter Property="IsCompact" Value="True" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="AllowFocusOnInteraction" Value="True" />
            </Style>

            <Style x:Key="SfGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="SfIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Padding" Value="6" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SfToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="ToolTipService.Placement" Value="Bottom" />
            </Style>

            <Style x:Key="SfSidebarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="24" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <Style x:Key="SfBreadcrumbButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="SfTabItemStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style x:Key="SfSidebarHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SfEmptyHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="8,0,8,4" />
                <Setter Property="Opacity" Value="0.8" />
            </Style>

            <Style x:Key="SfSidebarListStyle" TargetType="ListView">
                <Setter Property="IsItemClickEnabled" Value="True" />
                <Setter Property="SelectionMode" Value="None" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            </Style>

            <Style x:Key="SfNavListItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <Style x:Key="SfDriveListItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <Style x:Key="SfFileListItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="SfTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style x:Key="SfColumnHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <Style x:Key="SfUsageBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="3" />
                <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="2" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
