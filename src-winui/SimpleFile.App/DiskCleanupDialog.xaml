<ContentDialog
    x:Class="SimpleFile.App.DiskCleanupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Disk Cleanup Analysis"
    PrimaryButtonText=""
    SecondaryButtonText=""
    CloseButtonText=""
    RequestedTheme="Dark">

    <Grid Width="700" Height="500">
        <!-- Phase 1: Configuration -->
        <StackPanel x:Name="PhaseConfig" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
            <InfoBar Title="Information" Message="The scan reports candidates only. It does not delete or move files." IsOpen="True" Severity="Informational" />
            <NumberBox x:Name="ThresholdInput" Header="Large file threshold (MB)" Value="100" Minimum="1" SpinButtonPlacementMode="Inline" />
            <Button x:Name="AnalyzeButton" Content="Analyze" Style="{ThemeResource AccentButtonStyle}" Click="AnalyzeButton_Click" HorizontalAlignment="Stretch" />
            <Button Content="Cancel" Click="CloseButton_Click" HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Phase 2: Scanning -->
        <StackPanel x:Name="PhaseScan" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <TextBlock Text="Analyzing disk usage..." />
            <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Width="300" />
            <TextBlock x:Name="ScanCurrentItem" TextWrapping="Wrap" MaxWidth="300" Foreground="{ThemeResource SfTextMutedBrush}" />
            <Button Content="Cancel" Click="CloseButton_Click" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Phase 3: Results -->
        <Grid x:Name="PhaseResults" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="SummaryText" Grid.Row="0" Margin="0,0,0,12" FontWeight="SemiBold" />

            <Pivot Grid.Row="1">
                <PivotItem Header="Large Files">
                    <ListView x:Name="LargeFilesList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FormattedSize}" Foreground="{ThemeResource SfTextMutedBrush}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>
                <PivotItem Header="Duplicates">
                    <ListView x:Name="DuplicatesList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,12">
                                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Paths}" Margin="16,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SfTextMutedBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>
            </Pivot>

            <Button Grid.Row="2" Content="Close" Click="CloseButton_Click" HorizontalAlignment="Right" Margin="0,16,0,0" />
        </Grid>
    </Grid>
</ContentDialog>
