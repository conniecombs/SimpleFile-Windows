<Window
    x:Class="SimpleFile.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleFile.App"
    Title="SimpleFile - File Explorer">
    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="{StaticResource SfBgPrimaryBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardAccelerator" />
            <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnUpAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource SfBgSecondaryBrush}" BorderBrush="{StaticResource SfBorderBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="16,16,16,8" FontSize="20" FontWeight="SemiBold" Text="SimpleFile" Foreground="{StaticResource SfTextPrimaryBrush}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="8,0,8,16" Spacing="12">
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SfTextMutedBrush}" Text="Quick Access" />
                            <Button
                                x:Name="QuickAccessCollapseButton"
                                HorizontalAlignment="Right"
                                Padding="6,2"
                                Click="OnToggleQuickAccess"
                                Content="▾" />
                        </Grid>
                        <ListView
                            x:Name="QuickAccessList"
                            IsItemClickEnabled="True"
                            ItemClick="OnQuickAccessClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:QuickAccessRow">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                                        <TextBlock Text="{x:Bind Icon}" />
                                        <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource SfTextPrimaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SfTextMutedBrush}" Text="My PC" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                                <Button
                                    x:Name="RefreshDrivesButton"
                                    Padding="6,2"
                                    Click="OnRefreshDrives"
                                    Content="↻"
                                    ToolTipService.ToolTip="Refresh drives and mapped network status" />
                                <Button
                                    x:Name="MyPcCollapseButton"
                                    Padding="6,2"
                                    Click="OnToggleMyPc"
                                    Content="▾" />
                            </StackPanel>
                        </Grid>
                        <ListView
                            x:Name="DriveList"
                            IsItemClickEnabled="True"
                            ItemClick="OnDriveClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:DriveRow">
                                    <StackPanel Padding="4" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Icon}" />
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="NoWrap" Foreground="{StaticResource SfTextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Badge}" FontSize="11" Foreground="{StaticResource SfTextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource SfTextMutedBrush}"
                                            Text="{x:Bind Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="8,8,8,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="BackButton" Click="OnBack" Content="◀" ToolTipService.ToolTip="Go Back" />
                    <Button x:Name="ForwardButton" Click="OnForward" Content="▶" ToolTipService.ToolTip="Go Forward" />
                    <Button x:Name="UpButton" Click="OnUp" Content="▲" ToolTipService.ToolTip="Go Up" />
                </StackPanel>
                <Grid x:Name="PathBar" Grid.Column="1" Background="{StaticResource SfBgSecondaryBrush}" CornerRadius="4" Padding="8,4">
                    <ScrollViewer x:Name="BreadcrumbScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="BreadcrumbHost" Orientation="Horizontal" />
                    </ScrollViewer>
                    <TextBox
                        x:Name="PathInput"
                        PlaceholderText="Enter path..."
                        Visibility="Collapsed"
                        KeyDown="OnPathInputKeyDown"
                        LostFocus="OnPathInputLostFocus" />
                </Grid>
                <Button Grid.Column="2" Click="OnEditPath" Content="✎" ToolTipService.ToolTip="Edit path" />
            </Grid>

            <InfoBar
                x:Name="MessageBar"
                Grid.Row="1"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational" />

            <Grid Grid.Row="2" Padding="12,4,12,4" Background="{StaticResource SfBgSecondaryBrush}" BorderBrush="{StaticResource SfBorderBrush}" BorderThickness="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSortName" Content="Name" />
                <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSortSize" Content="Size" />
                <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSortDate" Content="Modified" />
                <Button Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSortType" Content="Type" />
            </Grid>

            <ListView
                x:Name="FileList"
                Grid.Row="3"
                IsItemClickEnabled="True"
                ItemClick="OnFileClick"
                DoubleTapped="OnFileDoubleTapped"
                KeyDown="OnFileListKeyDown"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FileRow">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Icon}" />
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Foreground="{StaticResource SfTextMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" Foreground="{StaticResource SfTextMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind TypeText}" Foreground="{StaticResource SfTextMutedBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="4" Padding="12,6" Background="{StaticResource SfBgSecondaryBrush}" BorderBrush="{StaticResource SfBorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource SfTextMutedBrush}" Text="Starting simplefile-service…" />
                <TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="{StaticResource SfTextMutedBrush}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
