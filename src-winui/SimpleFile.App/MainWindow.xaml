<Window
    x:Class="SimpleFile.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleFile.App"
    xmlns:core="using:SimpleFile.Core"
    xmlns:ipc="using:SimpleFile.Ipc"
    Title="SimpleFile - File Explorer">
    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="{StaticResource SfBgPrimaryBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="F6" Invoked="OnDualPaneAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardAccelerator" />
            <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnUpAccelerator" />
            <KeyboardAccelerator Key="Number1" Modifiers="Menu" Invoked="OnFocusPrimaryAccelerator" />
            <KeyboardAccelerator Key="Number2" Modifiers="Menu" Invoked="OnFocusSecondaryAccelerator" />
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnNewTabAccelerator" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnCloseTabAccelerator" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="OnNextTabAccelerator" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control,Shift" Invoked="OnPreviousTabAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Control,Shift" Invoked="OnFocusPrimaryAccelerator" />
            <KeyboardAccelerator Key="Right" Modifiers="Control,Shift" Invoked="OnFocusSecondaryAccelerator" />
            <KeyboardAccelerator Key="N" Modifiers="Control,Shift" Invoked="OnNewFolderAccelerator" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewFileAccelerator" />
            <KeyboardAccelerator Key="F2" Invoked="OnRenameAccelerator" />
            <KeyboardAccelerator Key="Delete" Modifiers="Shift" Invoked="OnDeleteAccelerator" />
            <KeyboardAccelerator Key="Delete" Invoked="OnTrashAccelerator" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyAccelerator" />
            <KeyboardAccelerator Key="X" Modifiers="Control" Invoked="OnCutAccelerator" />
            <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteAccelerator" />
            <KeyboardAccelerator Key="F4" Invoked="OnOpenTerminalAccelerator" />
            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="OnSettingsAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource SfBgSecondaryBrush}" BorderBrush="{StaticResource SfBorderBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Padding="12,16,12,8" Spacing="8">
                <Grid>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="SimpleFile" Foreground="{StaticResource SfTextPrimaryBrush}" />
                    <Button
                        x:Name="DualPaneButton"
                        HorizontalAlignment="Right"
                        Padding="8,4"
                        Click="OnToggleDualPane"
                        Content="Dual"
                        ToolTipService.ToolTip="Toggle dual pane (F6)" />
                </Grid>
                <StackPanel x:Name="SidebarTargetSwitch" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                    <Button x:Name="SidebarLeftButton" Click="OnSidebarLeft" Content="Left" ToolTipService.ToolTip="Navigate left pane" />
                    <Button x:Name="SidebarRightButton" Click="OnSidebarRight" Content="Right" ToolTipService.ToolTip="Navigate right pane" />
                </StackPanel>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SearchBox"
                        PlaceholderText="Search current folder"
                        KeyDown="OnSearchKeyDown" />
                    <Button
                        Grid.Column="1"
                        Click="OnSearchClick"
                        Content="🔎"
                        ToolTipService.ToolTip="Search current folder" />
                    <Button
                        x:Name="SearchCancelButton"
                        Grid.Column="2"
                        Click="OnCancelSearchClick"
                        Content="✕"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Cancel search" />
                </Grid>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="8,0,8,16" Spacing="12">
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SfTextMutedBrush}" Text="Quick Access" />
                            <Button
                                x:Name="QuickAccessCollapseButton"
                                HorizontalAlignment="Right"
                                Padding="6,2"
                                Click="OnToggleQuickAccess"
                                Content="▾" />
                        </Grid>
                        <ListView
                            x:Name="QuickAccessList"
                            IsItemClickEnabled="True"
                            ItemClick="OnQuickAccessClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:QuickAccessRow">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                                        <TextBlock Text="{x:Bind Icon}" />
                                        <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource SfTextPrimaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SfTextMutedBrush}" Text="Smart Folders" />
                        </Grid>
                        <ListView
                            x:Name="SmartFoldersList"
                            IsItemClickEnabled="True"
                            ItemClick="OnSmartFolderClicked"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔍" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource SfTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="×" Padding="4,2" Click="OnDeleteSmartFolderClicked" Tag="{Binding Id}" Background="Transparent" BorderThickness="0" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SfTextMutedBrush}" Text="My PC" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                                <Button
                                    x:Name="RefreshDrivesButton"
                                    Padding="6,2"
                                    Click="OnRefreshDrives"
                                    Content="↻"
                                    ToolTipService.ToolTip="Refresh drives and mapped network status" />
                                <Button
                                    x:Name="MyPcCollapseButton"
                                    Padding="6,2"
                                    Click="OnToggleMyPc"
                                    Content="▾" />
                            </StackPanel>
                        </Grid>
                        <ListView
                            x:Name="DriveList"
                            IsItemClickEnabled="True"
                            ItemClick="OnDriveClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:DriveRow">
                                    <StackPanel Padding="4" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Icon}" />
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="NoWrap" Foreground="{StaticResource SfTextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Badge}" FontSize="11" Foreground="{StaticResource SfTextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource SfTextMutedBrush}"
                                            Text="{x:Bind Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <InfoBar
                x:Name="MessageBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="PanesGrid" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
                        <ColumnDefinition x:Name="DividerColumn" Width="0" />
                        <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                <Grid
                    x:Name="PrimaryPaneRoot"
                    Grid.Column="0"
                    BorderBrush="{StaticResource SfAccentBrush}"
                    BorderThickness="0"
                    PointerPressed="OnPrimaryPanePressed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="4,4,4,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PrimaryTabHost" Orientation="Horizontal" />
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Row="1" Padding="8,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="PrimaryBackButton" Click="OnPrimaryBack" Content="◀" ToolTipService.ToolTip="Go Back" />
                            <Button x:Name="PrimaryForwardButton" Click="OnPrimaryForward" Content="▶" ToolTipService.ToolTip="Go Forward" />
                            <Button x:Name="PrimaryUpButton" Click="OnPrimaryUp" Content="▲" ToolTipService.ToolTip="Go Up" />
                        </StackPanel>
                        <Grid x:Name="PrimaryPathBar" Grid.Column="1" Background="{StaticResource SfBgSecondaryBrush}" CornerRadius="4" Padding="8,4">
                            <ScrollViewer x:Name="PrimaryBreadcrumbScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PrimaryBreadcrumbHost" Orientation="Horizontal" />
                            </ScrollViewer>
                            <TextBox
                                x:Name="PrimaryPathInput"
                                PlaceholderText="Enter path..."
                                Visibility="Collapsed"
                                KeyDown="OnPrimaryPathKeyDown"
                                LostFocus="OnPrimaryPathLostFocus" />
                        </Grid>
                        <Button Grid.Column="2" Click="OnEditPrimaryPath" Content="✎" ToolTipService.ToolTip="Edit left pane path" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                            <Button Click="OnPrimaryNewFolder" Content="📁+" ToolTipService.ToolTip="New Folder (Ctrl+Shift+N)" />
                            <Button Click="OnPrimaryNewFile" Content="📄+" ToolTipService.ToolTip="New File (Ctrl+N)" />
                            <Button Click="OnPrimaryRename" Content="✏️" ToolTipService.ToolTip="Rename (F2)" />
                            <Button Click="OnPrimaryDelete" Content="🗑️" ToolTipService.ToolTip="Trash (Delete)" />
                            <Button Click="OnSettingsClicked" Content="⚙" ToolTipService.ToolTip="Settings" />
                            <DropDownButton Content="🏷" ToolTipService.ToolTip="Tags">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Set Color Label" Click="OnSetColorLabelClicked" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton Content="⋮" ToolTipService.ToolTip="More Actions">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="View Archive Contents" Click="OnViewArchiveClicked" />
                                        <MenuFlyoutItem Text="Extract Archive" Click="OnExtractArchiveClicked" />
                                        <MenuFlyoutItem Text="Create Archive" Click="OnCreateArchiveClicked" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Find Duplicates" Click="OnDuplicateCheckerClicked" />
                                        <MenuFlyoutItem Text="Disk Cleanup" Click="OnDiskCleanupClicked" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Open Terminal Here" Click="OnOpenTerminalClicked" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Padding="12,4,12,4" Background="{StaticResource SfBgSecondaryBrush}" BorderBrush="{StaticResource SfBorderBrush}" BorderThickness="0,1,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSortName" Content="Name" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSortSize" Content="Size" />
                        <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSortDate" Content="Modified" />
                        <Button Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSortType" Content="Type" />
                    </Grid>
                    <ListView
                        x:Name="PrimaryFileList"
                        Grid.Row="3"
                        IsItemClickEnabled="True"
                        ItemClick="OnPrimaryFileClick"
                        DoubleTapped="OnPrimaryFileDoubleTapped"
                        KeyDown="OnPrimaryFileKeyDown"
                        SelectionChanged="OnPrimarySelectionChanged"
                        SelectionMode="Multiple">
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Set Color Label" Click="OnSetColorLabelClicked" />
                                <MenuFlyoutItem Text="Compress to Archive" Click="OnCreateArchiveClicked" />
                                <MenuFlyoutItem Text="Extract Archive" Click="OnExtractArchiveClicked" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FileRow">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Icon}" />
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Foreground="{StaticResource SfTextMutedBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" Foreground="{StaticResource SfTextMutedBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind TypeText}" Foreground="{StaticResource SfTextMutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border
                    x:Name="PaneDivider"
                    Grid.Column="1"
                    Background="{StaticResource SfBorderBrush}"
                    PointerPressed="OnDividerPressed"
                    PointerMoved="OnDividerMoved"
                    PointerReleased="OnDividerReleased"
                    Visibility="Collapsed" />

                <Grid
                    x:Name="SecondaryPaneRoot"
                    Grid.Column="2"
                    BorderBrush="{StaticResource SfAccentBrush}"
                    BorderThickness="0"
                    PointerPressed="OnSecondaryPanePressed"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="4,4,4,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SecondaryTabHost" Orientation="Horizontal" />
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Row="1" Padding="8,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="SecondaryBackButton" Click="OnSecondaryBack" Content="◀" ToolTipService.ToolTip="Go Back" />
                            <Button x:Name="SecondaryForwardButton" Click="OnSecondaryForward" Content="▶" ToolTipService.ToolTip="Go Forward" />
                            <Button x:Name="SecondaryUpButton" Click="OnSecondaryUp" Content="▲" ToolTipService.ToolTip="Go Up" />
                        </StackPanel>
                        <Grid Grid.Column="1" Background="{StaticResource SfBgSecondaryBrush}" CornerRadius="4" Padding="8,4">
                            <ScrollViewer x:Name="SecondaryBreadcrumbScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="SecondaryBreadcrumbHost" Orientation="Horizontal" />
                            </ScrollViewer>
                            <TextBox
                                x:Name="SecondaryPathInput"
                                PlaceholderText="Enter path..."
                                Visibility="Collapsed"
                                KeyDown="OnSecondaryPathKeyDown"
                                LostFocus="OnSecondaryPathLostFocus" />
                        </Grid>
                        <Button Grid.Column="2" Click="OnEditSecondaryPath" Content="✎" ToolTipService.ToolTip="Edit right pane path" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                            <Button Click="OnSecondaryNewFolder" Content="📁+" ToolTipService.ToolTip="New Folder (Ctrl+Shift+N)" />
                            <Button Click="OnSecondaryNewFile" Content="📄+" ToolTipService.ToolTip="New File (Ctrl+N)" />
                            <Button Click="OnSecondaryRename" Content="✏️" ToolTipService.ToolTip="Rename (F2)" />
                            <Button Click="OnSecondaryDelete" Content="🗑️" ToolTipService.ToolTip="Trash (Delete)" />
                            <Button Click="OnSettingsClicked" Content="⚙" ToolTipService.ToolTip="Settings" />
                            <DropDownButton Content="🏷" ToolTipService.ToolTip="Tags">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Set Color Label" Click="OnSetColorLabelClicked" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton Content="⋮" ToolTipService.ToolTip="More Actions">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="View Archive Contents" Click="OnViewArchiveClicked" />
                                        <MenuFlyoutItem Text="Extract Archive" Click="OnExtractArchiveClicked" />
                                        <MenuFlyoutItem Text="Create Archive" Click="OnCreateArchiveClicked" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Find Duplicates" Click="OnDuplicateCheckerClicked" />
                                        <MenuFlyoutItem Text="Disk Cleanup" Click="OnDiskCleanupClicked" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Open Terminal Here" Click="OnOpenTerminalClicked" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Padding="12,4,12,4" Background="{StaticResource SfBgSecondaryBrush}" BorderBrush="{StaticResource SfBorderBrush}" BorderThickness="0,1,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSortName" Content="Name" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSortSize" Content="Size" />
                        <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSortDate" Content="Modified" />
                        <Button Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSortType" Content="Type" />
                    </Grid>
                    <ListView
                        x:Name="SecondaryFileList"
                        Grid.Row="3"
                        IsItemClickEnabled="True"
                        ItemClick="OnSecondaryFileClick"
                        DoubleTapped="OnSecondaryFileDoubleTapped"
                        KeyDown="OnSecondaryFileKeyDown"
                        SelectionChanged="OnSecondarySelectionChanged"
                        SelectionMode="Multiple">
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Set Color Label" Click="OnSetColorLabelClicked" />
                                <MenuFlyoutItem Text="Compress to Archive" Click="OnCreateArchiveClicked" />
                                <MenuFlyoutItem Text="Extract Archive" Click="OnExtractArchiveClicked" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FileRow">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Icon}" />
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Foreground="{StaticResource SfTextMutedBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" Foreground="{StaticResource SfTextMutedBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind TypeText}" Foreground="{StaticResource SfTextMutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                </Grid>

                <Border
                    x:Name="PreviewPane"
                    Grid.Column="1"
                    Background="{StaticResource SfBgSecondaryBrush}"
                    BorderBrush="{StaticResource SfBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="PreviewTitle"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SfTextPrimaryBrush}"
                                Text="Preview" />
                            <TextBlock
                                x:Name="PreviewSubtitle"
                                FontSize="12"
                                Foreground="{StaticResource SfTextMutedBrush}"
                                Text="Select a file" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button
                                    x:Name="PreviewOpenButton"
                                    Click="OnPreviewOpenClick"
                                    Content="Open"
                                    IsEnabled="False" />
                                <Button
                                    x:Name="PreviewOpenWithButton"
                                    Click="OnPreviewOpenWithClick"
                                    Content="Open With"
                                    IsEnabled="False" />
                                <Button
                                    x:Name="PreviewRevealButton"
                                    Click="OnPreviewRevealClick"
                                    Content="Reveal"
                                    IsEnabled="False" />
                            </StackPanel>
                            <Button
                                x:Name="PreviewCompareButton"
                                HorizontalAlignment="Left"
                                Click="OnPreviewCompareClick"
                                Content="Compare Selected"
                                IsEnabled="False" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <Image
                                    x:Name="PreviewImage"
                                    MaxHeight="220"
                                    Stretch="Uniform"
                                    Visibility="Collapsed" />
                                <TextBox
                                    x:Name="PreviewTextBox"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    IsReadOnly="True"
                                    MaxHeight="280"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    TextWrapping="NoWrap"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="PreviewEmptyText"
                                    Foreground="{StaticResource SfTextMutedBrush}"
                                    Text="No preview loaded."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SfTextPrimaryBrush}"
                                    Text="Metadata" />
                                <StackPanel x:Name="PreviewMetadataRows" Spacing="4" />
                                <Button
                                    x:Name="PreviewChecksumButton"
                                    HorizontalAlignment="Left"
                                    Click="OnPreviewChecksumClick"
                                    Content="Checksums"
                                    IsEnabled="False" />
                                <TextBlock
                                    x:Name="PreviewChecksumText"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="{StaticResource SfTextMutedBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <local:ProgressPanel
                x:Name="FileProgressPanel"
                Grid.Row="1"
                Visibility="Collapsed" />

            <Grid Grid.Row="2" Padding="12,6" Background="{StaticResource SfBgSecondaryBrush}" BorderBrush="{StaticResource SfBorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource SfTextMutedBrush}" Text="Starting simplefile-service…" />
                <TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="{StaticResource SfTextMutedBrush}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
