<UserControl
    x:Class="SimpleFile.App.ProgressPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="8" Padding="16" Margin="8"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            MinWidth="320">
        <StackPanel Spacing="8">
            <TextBlock x:Name="OperationLabel" Style="{ThemeResource CaptionTextBlockStyle}" />
            <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" />
            <TextBlock x:Name="CurrentItemLabel" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
            <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Right" />
        </StackPanel>
    </Border>
</UserControl>
