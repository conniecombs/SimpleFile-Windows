<ContentDialog
    x:Class="SimpleFile.App.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    PrimaryButtonText="Save"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary">
    
    <Grid Width="600" Height="400">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Column="0" BorderBrush="{StaticResource SfBorderBrush}" BorderThickness="0,0,1,0" Padding="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search settings..." Margin="0,0,0,12" TextChanged="OnSearchTextChanged" />
            <ListView x:Name="CategoryList" Grid.Row="1" SelectionChanged="OnCategorySelectionChanged">
                <ListViewItem Content="Appearance" />
                <ListViewItem Content="Navigation" />
                <ListViewItem Content="Behavior" />
                <ListViewItem Content="Tools" />
                <ListViewItem Content="Updates" />
                <ListViewItem Content="About" />
            </ListView>
        </Grid>
        
        <ScrollViewer Grid.Column="1" Padding="12,0,0,0">
            <Grid x:Name="SettingsContentGrid">
                
                <StackPanel x:Name="AppearancePanel" Spacing="16" Visibility="Visible">
                    <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox x:Name="ThemeComboBox" Header="Theme" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Windows default" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                    <ComboBox x:Name="ColumnPresetComboBox" Header="File list columns" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Default" Tag="default" />
                        <ComboBoxItem Content="Details" Tag="details" />
                        <ComboBoxItem Content="Media" Tag="media" />
                        <ComboBoxItem Content="Developer" Tag="developer" />
                        <ComboBoxItem Content="Photo" Tag="photo" />
                    </ComboBox>
                    <ToggleSwitch x:Name="ShowHiddenSwitch" Header="Show Hidden Files" />
                </StackPanel>
                
                <StackPanel x:Name="NavigationPanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Navigation" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox x:Name="StartLocationComboBox" Header="Start Location" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Home" Tag="Home" />
                        <ComboBoxItem Content="Last" Tag="Last" />
                        <ComboBoxItem Content="Custom" Tag="Custom" />
                    </ComboBox>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomPathBox" Header="Custom Path" />
                        <Button Grid.Column="1" Content="Browse..." VerticalAlignment="Bottom" Click="OnBrowseCustomPath" />
                    </Grid>
                    <ToggleSwitch x:Name="OpenInNewTabSwitch" Header="Open folders in new tab" />
                </StackPanel>
                
                <StackPanel x:Name="BehaviorPanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Behavior" FontSize="18" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="ConfirmDeleteSwitch" Header="Confirm before delete" />
                    <ToggleSwitch x:Name="UseTrashSwitch" Header="Use Trash (Recycle Bin)" />
                    <ToggleSwitch x:Name="ShowFolderSizesSwitch" Header="Show folder sizes" />
                    <ToggleSwitch x:Name="EnableGitSwitch" Header="Enable Git integration" />
                </StackPanel>
                
                <StackPanel x:Name="ToolsPanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Tools" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Spacing="8" Background="{StaticResource SfBgSecondaryBrush}" Padding="12" CornerRadius="4">
                        <TextBlock Text="RAR Extraction Support" FontWeight="SemiBold" />
                        <TextBlock x:Name="RarStatusText" Text="Checking status..." Foreground="{StaticResource SfTextMutedBrush}" />
                        <Button x:Name="InstallRarButton" Content="Install RAR Support" Click="OnInstallRarClicked" />
                    </StackPanel>
                </StackPanel>
                
                <StackPanel x:Name="UpdatesPanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="CurrentVersionText" Text="Current Version: " />
                    <Button x:Name="CheckUpdatesButton" Content="Check for Updates" Click="OnCheckUpdatesClicked" />
                    <Button x:Name="InstallUpdateButton" Content="Download &#38; Install" Visibility="Collapsed" Click="OnInstallUpdateClicked" />
                </StackPanel>
                
                <StackPanel x:Name="AboutPanel" Spacing="16" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="64" HorizontalAlignment="Center" />
                    <TextBlock Text="SimpleFile" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="AboutVersionText" Text="Version info" HorizontalAlignment="Center" Foreground="{StaticResource SfTextMutedBrush}" />
                    <HyperlinkButton Content="View on GitHub" NavigateUri="https://github.com/conniecombs/SimpleFile-Windows" HorizontalAlignment="Center" />
                </StackPanel>
                
            </Grid>
        </ScrollViewer>
    </Grid>
</ContentDialog>
